#we use YOLO model and it doesn't have knife 
import cv2
from ultralytics import YOLO
import matplotlib.pyplot as plt

model = YOLO("yolov8n.pt")

cap = cv2.VideoCapture("Videopath.mp4")


#confidence threshold because YOLO has scissors and detection rate reduced 
CONF_THRESHOLD = 0.25
DANGEROUS_OBJECTS = ["scissors", "knife"]

frame_count = 0

while True:
    success, frame = cap.read()
    if not success:
        break

    results = model(frame, verbose=False)

    for r in results:
        for box in r.boxes:
            cls_id = int(box.cls[0])
            label = model.names[cls_id]
            conf = float(box.conf[0])

            x1, y1, x2, y2 = map(int, box.xyxy[0])

            # magic : change scissors to knife 
            if label in DANGEROUS_OBJECTS and conf >= CONF_THRESHOLD:
                display_label = f"knife {conf:.2f}"

                
                cv2.rectangle(frame, (x1,y1), (x2,y2), (0,0,255), 2)

    
                cv2.putText(
                    frame,
                    display_label,
                    (x1, y1-10),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.7,
                    (0,0,255),
                    2
                )

    if frame_count % 20 == 0:
        img_rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
        plt.figure(figsize=(5,4))
        plt.imshow(img_rgb)
        plt.axis("off")
        plt.show()

    frame_count += 1

cap.release()
